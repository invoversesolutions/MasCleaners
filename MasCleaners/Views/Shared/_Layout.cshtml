<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MAS Cleaners</title>

    <meta name="description"
          content="MAS Cleaners - Professional cleaning services. From Mess to Fresh." />

    <link rel="icon" type="image/png" href="~/images/mas-logo.png" />

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Global Styles -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Project Styles -->
    <link rel="stylesheet"
          href="~/MasCleaners.styles.css"
          asp-append-version="true" />

          <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- =========================
         NAVIGATION
    ========================== -->

    <header class="site-header">

        <nav class="mas-navbar">

            <div class="mas-navbar-inner">

                <!-- Logo -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="mas-brand">

                    <img src="~/images/mas-logo.jpeg"
                         alt="MAS Cleaners Logo"
                         class="mas-logo" />

                    <div class="mas-brand-text">

                        <span class="mas-brand-name">
                            MAS Cleaners
                        </span>

                        <span class="mas-brand-tagline">
                            From Mess to Fresh.
                        </span>

                    </div>

                </a>


                <!-- Navigation -->

                <div class="mas-navigation">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="mas-nav-link">

                        <span class="nav-icon">
                            <i class="bi bi-house"></i>
                        </span>

                        Home

                    </a>
                  

                    <a asp-controller="Booking"
                       asp-action="Index"
                       class="mas-nav-link">

                        <span class="nav-icon">
                            <i class="bi bi-calendar3"></i>
                        </span>

                        Book Now

                    </a>
                    <a asp-controller="Home"
                       asp-action="About" class="mas-nav-link">

                        <span class="nav-icon">
                            <i class="bi bi-info-circle"></i>
                        </span>

                        About

                    </a>
                    <a asp-controller="Home"
                       asp-action="Contact" class="mas-nav-link">

                        <span class="nav-icon">
                            <i class="bi bi-telephone"></i>
                        </span>

                        Contact Us

                    </a>

                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="mas-nav-link">

                        <span class="nav-icon">
                            <i class="bi bi-lock"></i>
                        </span>

                        Admin

                    </a>

                </div>


                <!-- Mobile menu -->

                <button class="mas-mobile-toggle"
                        type="button"
                        aria-label="Open navigation"
                        id="mobileMenuButton">

                    <span></span>
                    <span></span>
                    <span></span>

                </button>

            </div>

        </nav>

    </header>


    <!-- =========================
         MAIN CONTENT
    ========================== -->

    <main>
        @RenderBody()
    </main>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer class="mas-footer">

        <div class="mas-footer-inner">

            <div>

                <strong>MAS Cleaners</strong>

                <p>
                    From Mess to Fresh.
                </p>

            </div>

            <div class="mas-footer-copy">

                &copy; @DateTime.Now.Year MAS Cleaners.
                All rights reserved.

            </div>

        </div>

    </footer>


    <!-- =========================
         SCRIPTS
    ========================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>