<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MAS Cleaners</title>

    <meta name="description"
          content="MAS Cleaners - Professional cleaning services. From Mess to Fresh." />

    <link rel="icon" type="image/jpeg" href="~/images/mas-logo.jpeg" />

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Global Styles -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Project Styles -->
    <link rel="stylesheet"
          href="~/MasCleaners.styles.css"
          asp-append-version="true" />

          <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- =========================
         NAVIGATION
    ========================== -->

    <header class="site-header">

        <nav class="mas-navbar">

            <div class="mas-navbar-inner">

                <!-- Logo -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="mas-brand">

                    <img src="~/images/mas-logo.jpeg"
                         alt="MAS Cleaners Logo"
                         class="mas-logo" />

                    <div class="mas-brand-text">

                        <span class="mas-brand-name">
                            MAS Cleaners
                        </span>

                        <span class="mas-brand-tagline">
                            From Mess to Fresh.
                        </span>

                    </div>

                </a>


                <!-- Navigation -->

                <div class="mas-navigation" id="mobileMenu">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="mas-nav-link">

                        <span class="nav-icon">
                            <i class="bi bi-house"></i>
                        </span>

                        Home

                    </a>
                  

                  <a asp-controller="Cart"
                       asp-action="Cart"
                       class="mas-nav-link">

                        <span class="nav-icon">
                            <i class="bi bi-cart3"></i>
                        </span>

                        Cart

                    </a>
                    <a asp-controller="Home"
                       asp-action="About" class="mas-nav-link">

                        <span class="nav-icon">
                            <i class="bi bi-info-circle"></i>
                        </span>

                        About

                    </a>
                    <a asp-controller="Home"
                       asp-action="Contact" class="mas-nav-link">

                        <span class="nav-icon">
                            <i class="bi bi-telephone"></i>
                        </span>

                        Contact Us

                    </a>

                <!-- Account Actions -->
                <div class="mas-nav-actions">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole(StaticRoles.Role_Super))
                        {
                            <a asp-controller="SuperDashboard"
                               asp-action="Index"
                               class="mas-nav-link mas-admin-link">
                                <i class="bi bi-speedometer2"></i>
                                Super Admin Panel
                            </a>
                        }
                          @if (User.IsInRole(StaticRoles.Role_Admin))
                        {
                            <a asp-controller="AdminDashboard"
                               asp-action="Index"
                               class="mas-nav-link mas-admin-link">
                                <i class="bi bi-speedometer2"></i>
                                Admin Panel
                            </a>
                        }
                        <a asp-controller="Account"
                           asp-action="Profile"
                           class="mas-signin-button">
                            <i class="bi bi-person-circle"></i>
                            My Account
                        </a>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="mas-logout-form">
                            <button type="submit"
                                    class="mas-started-button mas-logout-button">
                                <i class="bi bi-box-arrow-right"></i>
                                Sign Out
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="mas-signin-button">
                            Sign In
                        </a>

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="mas-started-button">
                            Get Started
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }

                </div>

                </div>


                <!-- Mobile menu -->

                <button class="mas-mobile-toggle"
                        type="button"
                        aria-label="Open navigation"
                        id="mobileMenuButton">

                    <span></span>
                    <span></span>
                    <span></span>

                </button>

            </div>

        </nav>

    </header>


 

<!-- =========================
     MAIN CONTENT
========================== -->

<main class="mas-main-content">
    @RenderBody()
</main>


    <!-- =========================
         FOOTER
    ========================== -->


<!-- =====================================================
     MAS CLEANERS CORPORATE FOOTER
====================================================== -->

<footer class="mas-footer">

    <div class="mas-footer-main">

        <div class="mas-footer-container">

            <!-- COMPANY INFORMATION -->
            <div class="mas-footer-brand">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="mas-footer-logo">

                    <img src="~/images/mas-logo.jpeg"
                         alt="MAS Cleaners Logo" />

                    <div>
                        <strong>MAS Cleaners</strong>
                        <span>From Mess to Fresh.</span>
                    </div>

                </a>

                <p class="mas-footer-description">
                    We provide professional cleaning solutions
                    designed to create cleaner, healthier and
                    more welcoming spaces for homes and businesses.
                </p>

                <div class="mas-footer-established">
                    <i class="bi bi-patch-check-fill"></i>
                    <span>Trusted cleaning solutions since 2022</span>
                </div>

            </div>


            <!-- QUICK LINKS -->
            <div class="mas-footer-column">

                <h4>Quick Links</h4>

                <ul>
                    <li>
                        <a asp-controller="Home" asp-action="Index">
                            <i class="bi bi-chevron-right"></i>
                            Home
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Home" asp-action="About">
                            <i class="bi bi-chevron-right"></i>
                            About Us
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Home" asp-action="Contact">
                            <i class="bi bi-chevron-right"></i>
                            Contact Us
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Booking" asp-action="Index">
                            <i class="bi bi-chevron-right"></i>
                            Book a Cleaning
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Cart" asp-action="Cart">
                            <i class="bi bi-chevron-right"></i>
                            My Cart
                        </a>
                    </li>
                </ul>

            </div>


            <!-- OUR SERVICES -->
            <div class="mas-footer-column">

                <h4>Our Services</h4>

                <ul>
                    <li>
                        <a asp-controller="Home" asp-action="Index">
                            <i class="bi bi-chevron-right"></i>
                            Residential Cleaning
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Home" asp-action="Index">
                            <i class="bi bi-chevron-right"></i>
                            Commercial Cleaning
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Home" asp-action="Index">
                            <i class="bi bi-chevron-right"></i>
                            Deep Cleaning
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Home" asp-action="Index">
                            <i class="bi bi-chevron-right"></i>
                            Specialised Cleaning
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Home" asp-action="Index">
                            <i class="bi bi-chevron-right"></i>
                            Mobile Car Wash
                        </a>
                    </li>
                </ul>

            </div>


            <!-- CONTACT INFORMATION -->
            <div class="mas-footer-column mas-footer-contact">

                <h4>Get In Touch</h4>

                <p class="mas-footer-contact-intro">
                    Need a cleaner space? Our team is ready to help.
                </p>

                <a href="tel:+27614908391" class="mas-footer-contact-item">
                    <span class="mas-footer-contact-icon">
                        <i class="bi bi-telephone"></i>
                    </span>

                    <span>
                        <small>Call Us</small>
                        +27 61 490 8391
                    </span>
                </a>

                <a href="mailto:info@mascleaners.co.za"
                   class="mas-footer-contact-item">

                    <span class="mas-footer-contact-icon">
                        <i class="bi bi-envelope"></i>
                    </span>

                    <span>
                        <small>Email Us</small>
                        info@mascleaners.co.za
                    </span>
                </a>

                <div class="mas-footer-contact-item">

                    <span class="mas-footer-contact-icon">
                        <i class="bi bi-geo-alt"></i>
                    </span>

                    <span>
                        <small>Service Area</small>
                        Free State, South Africa
                    </span>

                </div>

                <a asp-controller="Home"
                   asp-action="Contact"
                   class="mas-footer-contact-button">

                    Contact Our Team
                    <i class="bi bi-arrow-up-right"></i>

                </a>

            </div>

        </div>

    </div>



<div class="mas-footer-bottom">

    <div class="mas-footer-bottom-inner">

        <!-- COPYRIGHT -->
        <div class="mas-footer-copyright">
            &copy; @DateTime.Now.Year
            <strong>MAS Cleaners.</strong>
            All rights reserved.
        </div>

        <!-- LEGAL LINKS -->
        <div class="mas-footer-legal">

            <a asp-controller="Legal"
               asp-action="PrivacyPolicy">
                Privacy Policy
            </a>

            <span class="mas-footer-legal-divider">|</span>

            <a asp-controller="Legal"
               asp-action="TermsAndConditions">
                Terms &amp; Conditions
            </a>

        </div>

        <!-- DEVELOPER CREDIT -->
        <div class="mas-footer-powered">
            <span>Powered by</span>
            <strong>InvoVerse Solutions</strong>
        </div>

    </div>

</div>
</footer>


</footer>



    <!-- =========================
         SCRIPTS
    ========================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>