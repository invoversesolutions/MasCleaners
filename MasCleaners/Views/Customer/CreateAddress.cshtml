@model MasCleaners.ViewModels.Customer.CustomerAddressVM

@{
    ViewData["Title"] = "Add New Address";
}
<link rel="stylesheet"
      href="~/css/customer-addresses.css"
      asp-append-version="true" />
<div class="mas-address-form-page">

    <div class="mas-address-form-header">

        <a asp-controller="Customer"
           asp-action="Addresses"
           class="mas-address-back-link">

            <i class="bi bi-arrow-left"></i>
            Back to Saved Addresses
        </a>

      

        <h1>Add a New Address</h1>

        <p>
            Enter the location where you would like MAS Cleaners
            to provide your cleaning service.
        </p>

    </div>

    <div class="mas-address-form-card">

        <div class="mas-address-form-card-heading">

            <div class="mas-address-icon">
                <i class="bi bi-geo-alt"></i>
            </div>

            <div>
                <h2>Address Details</h2>
                <p>Fields marked with * are required.</p>
            </div>

        </div>

        <form asp-controller="Customer"
              asp-action="CreateAddress"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mas-address-form-grid">

                <div class="mas-address-field mas-address-field-full">

                    <label asp-for="AddressName"></label>

                    <input asp-for="AddressName"
                           class="form-control"
                           placeholder="e.g. Home, Office, Parents' House" />

                    <span asp-validation-for="AddressName"
                          class="text-danger">
                    </span>

                </div>

                <div class="mas-address-field mas-address-field-full">

                    <label asp-for="AddressLine1"></label>

                    <input asp-for="AddressLine1"
                           class="form-control"
                           placeholder="Street number and street name" />

                    <span asp-validation-for="AddressLine1"
                          class="text-danger">
                    </span>

                </div>

                <div class="mas-address-field mas-address-field-full">

                    <label asp-for="AddressLine2"></label>

                    <input asp-for="AddressLine2"
                           class="form-control"
                           placeholder="Complex, unit, building or suburb (optional)" />

                    <span asp-validation-for="AddressLine2"
                          class="text-danger">
                    </span>

                </div>

                <div class="mas-address-field">

                    <label asp-for="City"></label>

                    <input asp-for="City"
                           class="form-control"
                           placeholder="e.g. Welkom" />

                    <span asp-validation-for="City"
                          class="text-danger">
                    </span>

                </div>

                <div class="mas-address-field">

                    <label asp-for="Province"></label>

                    <select asp-for="Province"
                            class="form-select">

                        <option value="">Select province</option>
                        <option value="Eastern Cape">Eastern Cape</option>
                        <option value="Free State">Free State</option>
                        <option value="Gauteng">Gauteng</option>
                        <option value="KwaZulu-Natal">KwaZulu-Natal</option>
                        <option value="Limpopo">Limpopo</option>
                        <option value="Mpumalanga">Mpumalanga</option>
                        <option value="Northern Cape">Northern Cape</option>
                        <option value="North West">North West</option>
                        <option value="Western Cape">Western Cape</option>

                    </select>

                    <span asp-validation-for="Province"
                          class="text-danger">
                    </span>

                </div>

                <div class="mas-address-field">

                    <label asp-for="PostalCode"></label>

                    <input asp-for="PostalCode"
                           class="form-control"
                           placeholder="e.g. 9459"
                           autocomplete="postal-code" />

                    <span asp-validation-for="PostalCode"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="mas-address-default-option">

                <label class="mas-address-checkbox">

                    <input asp-for="IsDefault" />

                    <span class="mas-address-checkbox-content">

                        <strong>Set as my default address</strong>

                        <small>
                            Use this as your preferred address when booking.
                        </small>

                    </span>

                </label>

            </div>

            <div class="mas-address-form-actions">

                <a asp-controller="Customer"
                   asp-action="Addresses"
                   class="mas-address-cancel-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="mas-address-primary-btn">

                    <i class="bi bi-check2-circle"></i>
                    Save Address

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}