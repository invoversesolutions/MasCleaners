@{
    ViewData["Title"] = "About Us";
}

<link rel="stylesheet"
      href="~/css/home/about.css"
      asp-append-version="true" />

<div class="about-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="about-hero">

        <div class="about-hero-content">

            <span class="about-eyebrow">
                <i class="bi bi-stars"></i>
                About MAS Cleaners
            </span>

            <h1>
                From Mess
                <span>to Fresh.</span>
            </h1>

            <p>
                Professional cleaning services built around
                quality, reliability and a commitment to
                making every space feel fresh again.
            </p>

        </div>

    </section>


    <!-- =====================================================
         OUR STORY
    ====================================================== -->

    <section class="about-section">

        <div class="about-container">

            <div class="about-grid">

                <div class="about-content">

                    <span class="section-label">
                        Our Story
                    </span>

                    <h2>
                        Cleaning spaces.
                        <br />
                        Creating freshness.
                    </h2>

                    <p>
                        MAS Cleaners was established in 2022
                        with a commitment to providing
                        professional and reliable cleaning
                        services to homes, businesses and
                        other spaces across the Free State.
                    </p>

                    <p>
                        Since then, the business has continued
                        to serve customers across the province,
                        with a particularly strong presence in
                        <strong>Welkom</strong> and
                        <strong>Bloemfontein</strong>.
                    </p>

                    <p>
                        Our approach is simple: we believe that
                        a clean environment can make a meaningful
                        difference to how people live, work and
                        experience their spaces.
                    </p>

                </div>


                <div class="about-highlight">

                    <div class="about-highlight-icon">
                        <i class="bi bi-house-check"></i>
                    </div>

                    <span>Established</span>

                    <strong>2022</strong>

                    <p>
                        Proudly serving the Free State
                        province.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         WHERE WE OPERATE
    ====================================================== -->

    <section class="about-locations">

        <div class="about-container">

            <div class="section-heading">

                <span class="section-label">
                    Where We Operate
                </span>

                <h2>
                    Proudly serving the
                    <span>Free State.</span>
                </h2>

                <p>
                    MAS Cleaners has built a strong presence
                    across the Free State, with a particular
                    focus on Welkom and Bloemfontein.
                </p>

            </div>


            <div class="location-grid">

                <div class="location-card">

                    <div class="location-icon">
                        <i class="bi bi-geo-alt"></i>
                    </div>

                    <h3>Welkom</h3>

                    <p>
                        Serving homes, businesses and
                        commercial spaces throughout Welkom.
                    </p>

                </div>


                <div class="location-card">

                    <div class="location-icon">
                        <i class="bi bi-geo-alt"></i>
                    </div>

                    <h3>Bloemfontein</h3>

                    <p>
                        Providing professional cleaning
                        services across Bloemfontein.
                    </p>

                </div>


                <div class="location-card">

                    <div class="location-icon">
                        <i class="bi bi-map"></i>
                    </div>

                    <h3>Free State</h3>

                    <p>
                        Bringing professional cleaning
                        solutions to customers across the
                        province.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CTA
    ====================================================== -->

    <section class="about-cta">

        <div>

            <span>
                Ready for a fresher space?
            </span>

            <h2>
                Let us take the mess
                off your hands.
            </h2>

        </div>

        <a asp-controller="Booking"
           asp-action="Index"
           class="about-cta-button">

            <i class="bi bi-calendar3"></i>

            Book a Cleaning

        </a>

    </section>

</div>