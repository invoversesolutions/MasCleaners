@model IEnumerable<MasCleaners.ViewModels.HomeServiceCategoryVM>

@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/home/index.css"
          asp-append-version="true" />
}


<!-- =========================================================
     HERO
========================================================== -->

<section class="mas-hero">

    <div class="mas-hero-track" id="heroTrack">

        <!-- SLIDE 1 -->

        <div class="mas-hero-slide active">

            <img src="~/images/hero-1.jpg"
                 alt="Professional residential cleaning"
                 class="mas-hero-image" />

            <div class="mas-hero-overlay"></div>

            <div class="mas-hero-content">

                <span class="mas-hero-category">
                    <i class="bi bi-stars"></i>
                    Residential Cleaning
                </span>

                <h1>
                    Clean Space.
                </h1>

                <p>
                    Fresh homes. Fresh spaces.
                    Fresh beginnings.
                </p>

             <div class="mas-hero-actions">

                    <!-- PRIMARY BUTTON -->
                    <a asp-controller="Booking"
                       asp-action="Index"
                       class="mas-hero-button">
                        <i class="bi bi-calendar3"></i>
                        Book a Cleaning
                    </a>

                    <!-- SECONDARY BUTTON -->
                    <a asp-controller="Home"
                       asp-action="Services"
                       class="mas-hero-button mas-hero-button-secondary">
                        <i class="bi bi-stars"></i>
                        View Services
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>

        </div>


        <!-- SLIDE 2 -->

        <div class="mas-hero-slide">

            <img src="~/images/hero-2.jpg"
                 alt="Professional deep cleaning"
                 class="mas-hero-image" />

            <div class="mas-hero-overlay"></div>

            <div class="mas-hero-content">

                <span class="mas-hero-category">
                    <i class="bi bi-stars"></i>
                    Deep Cleaning
                </span>

                <h1>
                    Deep Clean.
                </h1>

                <p>
                    We don't just clean.
                    We transform spaces.
                </p>

                   <div class="mas-hero-actions">

                    <!-- PRIMARY BUTTON -->
                    <a asp-controller="Booking"
                       asp-action="Index"
                       class="mas-hero-button">
                        <i class="bi bi-calendar3"></i>
                        Book a Cleaning
                    </a>

                    <!-- SECONDARY BUTTON -->
                    <a asp-controller="Home"
                       asp-action="Services"
                       class="mas-hero-button mas-hero-button-secondary">
                        <i class="bi bi-stars"></i>
                        View Services
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>

        </div>


        <!-- SLIDE 3 -->

        <div class="mas-hero-slide">

            <img src="~/images/hero-3.jpg"
                 alt="Commercial cleaning service"
                 class="mas-hero-image" />

            <div class="mas-hero-overlay"></div>

            <div class="mas-hero-content">

                <span class="mas-hero-category">
                    <i class="bi bi-building"></i>
                    Commercial & Office
                </span>

                <h1>
                    Fresh Business.
                </h1>

                <p>
                    Professional cleaning
                    for professional spaces.
                </p>

                <div class="mas-hero-actions">

                    <!-- PRIMARY BUTTON -->
                    <a asp-controller="Booking"
                       asp-action="Index"
                       class="mas-hero-button">
                        <i class="bi bi-calendar3"></i>
                        Book a Cleaning
                    </a>

                    <!-- SECONDARY BUTTON -->
                    <a asp-controller="Home"
                       asp-action="Services"
                       class="mas-hero-button mas-hero-button-secondary">
                        <i class="bi bi-stars"></i>
                        View Services
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- PREVIOUS -->

    <button class="hero-arrow hero-arrow-left"
            type="button"
            id="heroPrevious"
            aria-label="Previous slide">

        <i class="bi bi-chevron-left"></i>

    </button>


    <!-- NEXT -->

    <button class="hero-arrow hero-arrow-right"
            type="button"
            id="heroNext"
            aria-label="Next slide">

        <i class="bi bi-chevron-right"></i>

    </button>


    <!-- INDICATORS -->

    <div class="hero-indicators">

        <button type="button"
                class="hero-indicator active"
                data-slide="0"
                aria-label="Go to slide 1">
        </button>

        <button type="button"
                class="hero-indicator"
                data-slide="1"
                aria-label="Go to slide 2">
        </button>

        <button type="button"
                class="hero-indicator"
                data-slide="2"
                aria-label="Go to slide 3">
        </button>

    </div>

</section>


<!-- =========================================================
     TRUST BAR
========================================================== -->

<section class="mas-trust-bar">

    <div class="mas-trust-inner">

        <div class="mas-trust-item">
            <i class="bi bi-check2"></i>
            Fully Insured
        </div>

        <div class="mas-trust-item">
            <i class="bi bi-check2"></i>
            Same-Day Bookings
        </div>

        <div class="mas-trust-item">
            <i class="bi bi-check2"></i>
            4.9★ Rated
        </div>

        <div class="mas-trust-item">
            <i class="bi bi-check2"></i>
            Online Payment
        </div>

        <div class="mas-trust-item">
            <i class="bi bi-check2"></i>
            Instant Confirmation
        </div>

    </div>

</section>


<!-- =========================================================
     SERVICE SEARCH
========================================================== -->

<section class="mas-service-search-section">

    <div class="mas-service-search">

        <i class="bi bi-search"></i>

        <input type="search"
               id="serviceSearch"
               placeholder="Search services — 'mattress', 'couch', 'post-event', 'eco'..."
               autocomplete="off" />

    </div>

</section>

<!-- =========================================================
     SERVICES
========================================================== -->

<section class="mas-services-section">

    <div class="mas-container">

        <div class="mas-section-heading">

            <h2>
                Our Services
            </h2>

            <p>
                Professional cleaning services tailored to your needs.
                Choose a service category and explore the available options.
            </p>

        </div>


        <!-- =====================================================
             SERVICE GRID
        ====================================================== -->

        <div class="row g-4"
             id="servicesGrid">

            @foreach (var service in Model)
            {
                <div class="col-lg-4 col-md-6 service-item"
                     data-search="@service.Name @service.Description">

                    <article class="service-card">

                        <!-- =================================================
                             IMAGE
                        ================================================== -->

                        <div class="service-image-wrapper">

                            <img src="@service.ImageUrl"
                                 alt="@service.Name"
                                 class="service-image" />

                        </div>


                        <!-- =================================================
                             BODY
                        ================================================== -->

                        <div class="service-body">


                            <!-- TITLE -->

                            <div class="service-title-row">

                                <i class="bi @(string.IsNullOrWhiteSpace(service.Icon)
                                    ? "bi-stars"
                                    : service.Icon) service-icon">
                                </i>

                                <h3>
                                    @service.Name
                                </h3>

                            </div>


                            <!-- DESCRIPTION -->

                            @if (!string.IsNullOrWhiteSpace(service.Description))
                            {
                                <p>
                                    @service.Description
                                </p>
                            }


                            <div class="service-divider"></div>


                            <!-- =================================================
                                 FOOTER
                            ================================================== -->

                            <div class="service-footer">


                                <!-- PRICE -->

                                <div class="service-price">

                                    @if (service.StartingPrice > 0)
                                    {
                                        <strong>
                                            From R @service.StartingPrice.ToString("N0")
                                        </strong>
                                    }
                                    else
                                    {
                                        <strong>
                                            Price on Request
                                        </strong>
                                    }

                                    <span>

                                        @service.ServiceOptionCount

                                        @(service.ServiceOptionCount == 1
                                            ? "option"
                                            : "options")

                                    </span>

                                </div>


                                <!-- VIEW OPTIONS -->

                                <a asp-controller="Home"
                                   asp-action="Options"
                                   asp-route-serviceCategoryId="@service.Id"
                                   class="service-book-button">

                                    View Options

                                    <i class="bi bi-arrow-right"></i>

                                </a>

                            </div>

                        </div>

                    </article>

                </div>
            }

        </div>


        <!-- =====================================================
             NO RESULTS
        ====================================================== -->

        <div id="noServices"
             class="services-no-results"
             style="display:none;">

            <i class="bi bi-search"></i>

            <h3>
                No services found
            </h3>

            <p>
                Try another search term.
            </p>

        </div>

    </div>

</section>

@section Scripts {
    <script src="~/js/home/index.js"
            asp-append-version="true"></script>
}