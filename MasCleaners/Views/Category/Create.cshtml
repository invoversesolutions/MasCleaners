@model MasCleaners.Models.ServiceCategory

@{
    ViewData["Title"] = "Create Service";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/category/create.css"
          asp-append-version="true" />
}

<div class="category-page">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="category-page-header">

        <div>

            <div class="category-breadcrumb">

                <a asp-controller="Category"
                   asp-action="Index">
                    Services
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>Create</span>

            </div>

            <h1>
                Create Service
            </h1>

            <p>
                Create a service and configure how it will appear in the catalogue.
            </p>

        </div>


        <a asp-controller="Category"
           asp-action="Index"
           class="category-back-btn">

            <i class="bi bi-arrow-left"></i>

            Back to Services

        </a>

    </div>


    <!-- =====================================================
         FORM CARD
    ====================================================== -->

    <div class="category-form-card">


        <!-- FORM HEADER -->

        <div class="category-form-header">

            <div class="category-form-icon">

                <i class="bi bi-grid"></i>

            </div>

            <div>

                <h3>
                    Service Information
                </h3>

                <p>
                    Enter the details for this service.
                </p>

            </div>

        </div>


        <!-- =================================================
             FORM
        ================================================== -->

        <form asp-controller="Category"
              asp-action="Create"
              method="post"
              enctype="multipart/form-data"
              class="category-form">

            @Html.AntiForgeryToken()


            <!-- VALIDATION -->

            <div asp-validation-summary="ModelOnly"
                 class="category-validation">
            </div>


            <!-- =================================================
                 SERVICE NAME
            ================================================== -->

            <div class="category-form-group">

                <label asp-for="Name">

                    Service Name

                    <span>*</span>

                </label>


                <div class="category-input-wrapper">

                    <i class="bi bi-tag"></i>

                    <input asp-for="Name"
                           class="category-input"
                           placeholder="e.g. Residential Cleaning"
                           autocomplete="off" />

                </div>


                <span asp-validation-for="Name"
                      class="category-field-error">
                </span>

            </div>


            <!-- =================================================
                 DESCRIPTION
            ================================================== -->

            <div class="category-form-group">

                <label asp-for="Description">

                    Description

                </label>


                <div class="category-input-wrapper category-textarea-wrapper">

                    <i class="bi bi-card-text"></i>

                    <textarea asp-for="Description"
                              class="category-input category-textarea"
                              placeholder="Describe this cleaning service..."
                              rows="5"></textarea>

                </div>


                <span asp-validation-for="Description"
                      class="category-field-error">
                </span>

            </div>


            <!-- =================================================
     SERVICE IMAGE
================================================== -->

            <div class="category-form-group">

                <label for="imageFile">

                    Service Image

                    <span>*</span>

                </label>

                <div class="category-input-wrapper">

                    <i class="bi bi-image"></i>

                    <input type="file"
                           name="imageFile"
                           id="imageFile"
                           class="category-input category-file-input"
                           accept=".jpg,.jpeg,.png,.webp"
                           required />

                </div>

                <small class="category-help">

                    Upload the image that will be displayed
                    for this service.

                    <strong>
                        JPG, PNG or WebP
                    </strong>

                </small>

            </div>

            <!-- =================================================
                 ICON
            ================================================== -->

            <div class="category-form-group">

                <label asp-for="Icon">

                    Bootstrap Icon

                </label>


                <div class="category-input-wrapper">

                    <i class="bi bi-stars"></i>

                    <input asp-for="Icon"
                           class="category-input"
                           placeholder="e.g. bi bi-house-door"
                           autocomplete="off" />

                </div>


                <small class="category-help">

                    Enter the Bootstrap Icons class.

                    Example:

                    <strong>
                        bi bi-house-door
                    </strong>

                </small>


                <span asp-validation-for="Icon"
                      class="category-field-error">
                </span>

            </div>


            <!-- =================================================
                 DISPLAY ORDER
            ================================================== -->

            <div class="category-form-group">

                <label asp-for="DisplayOrder">

                    Display Order

                </label>


                <div class="category-input-wrapper">

                    <i class="bi bi-list-ol"></i>

                    <input asp-for="DisplayOrder"
                           type="number"
                           min="0"
                           class="category-input"
                           placeholder="0" />

                </div>


                <small class="category-help">

                    Lower numbers will appear first on the public website.

                </small>


                <span asp-validation-for="DisplayOrder"
                      class="category-field-error">
                </span>

            </div>


            <!-- =================================================
                 ACTIVE STATUS
            ================================================== -->

            <div class="category-status-box">

                <div class="category-status-content">

                    <div class="category-status-icon">

                        <i class="bi bi-check-circle"></i>

                    </div>


                    <div>

                        <strong>
                            Active Service
                        </strong>

                        <p>
                            Allow this service to appear on the public website.
                        </p>

                    </div>

                </div>


                <div class="form-check form-switch">

                    <input asp-for="IsActive"
                           class="form-check-input category-switch"
                           type="checkbox" />

                    <label asp-for="IsActive"
                           class="form-check-label">

                        Active

                    </label>

                </div>

            </div>


            <!-- =================================================
                 ACTIONS
            ================================================== -->

            <div class="category-form-actions">

                <a asp-controller="Category"
                   asp-action="Index"
                   class="category-cancel-btn">

                    <i class="bi bi-x-lg"></i>

                    Cancel

                </a>


                <button type="submit"
                        class="category-submit-btn">

                    <i class="bi bi-check-lg"></i>

                    Create Service

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}