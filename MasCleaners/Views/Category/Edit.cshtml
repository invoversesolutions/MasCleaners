@model MasCleaners.Models.ServiceCategory

@{
    ViewData["Title"] = "Edit Service";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/category/edit.css"
          asp-append-version="true" />
}

<div class="category-page">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="category-page-header">

        <div>

            <div class="category-breadcrumb">

                <a asp-controller="Category"
                   asp-action="Index">

                    Services

                </a>

                <i class="bi bi-chevron-right"></i>

                <span>Edit Service</span>

            </div>


            <h1>
                Edit Service
            </h1>

            <p>
                Update the details and configuration of this service.
            </p>

        </div>


        <div class="category-header-actions">

            <a asp-controller="Category"
               asp-action="Index"
               class="category-back-button">

                <i class="bi bi-arrow-left"></i>

                Back to Services

            </a>

        </div>

    </div>


    <!-- =====================================================
         EDIT CARD
    ====================================================== -->

    <div class="category-form-card">


        <!-- =================================================
             FORM HEADER
        ================================================== -->

        <div class="category-form-header">

            <div class="category-form-icon">

                <i class="bi bi-pencil-square"></i>

            </div>


            <div>

                <h3>
                    Edit Service
                </h3>

                <p>
                    Update the information below and save your changes.
                </p>

            </div>

        </div>


        <!-- =================================================
             FORM
        ================================================== -->

        <form asp-controller="Category"
              asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()


            <!-- ID -->

            <input type="hidden"
                   asp-for="Id" />


            <!-- =================================================
                 VALIDATION
            ================================================== -->

            <div asp-validation-summary="ModelOnly"
                 class="category-validation">
            </div>


            <!-- =================================================
                 SERVICE NAME
            ================================================== -->

            <div class="category-form-group">

                <label asp-for="Name">

                    Service Name

                    <span>*</span>

                </label>


                <div class="category-input-wrapper">

                    <i class="bi bi-tag"></i>

                    <input asp-for="Name"
                           class="category-form-control"
                           placeholder="e.g. Residential Cleaning" />

                </div>


                <span asp-validation-for="Name"
                      class="category-field-error">
                </span>

            </div>


            <!-- =================================================
                 DESCRIPTION
            ================================================== -->

            <div class="category-form-group">

                <label asp-for="Description">

                    Description

                    <span>*</span>

                </label>


                <div class="category-input-wrapper category-textarea-wrapper">

                    <i class="bi bi-card-text"></i>

                    <textarea asp-for="Description"
                              class="category-form-control category-textarea"
                              rows="5"
                              placeholder="Describe this cleaning service..."></textarea>

                </div>


                <span asp-validation-for="Description"
                      class="category-field-error">
                </span>

            </div>


            <!-- =================================================
                 SERVICE IMAGE
            ================================================== -->

            <div class="category-form-group">

                <label for="imageFile">
                    Service Image
                </label>

                <div class="category-input-wrapper">

                    <i class="bi bi-image"></i>

                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           class="category-form-control"
                           accept="image/jpeg,image/png,image/webp" />

                </div>

                <small class="category-help">
                    Upload a new image only if you want to replace the
                    current service image.
                </small>

            </div>


            <!-- =================================================
                 CURRENT IMAGE
            ================================================== -->

            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <div class="category-image-preview">

                    <div class="category-image-preview-header">

                        <div>

                            <strong>
                                Current Service Image
                            </strong>

                            <span>
                                This image is currently displayed on the website.
                            </span>

                        </div>

                    </div>


                    <div class="category-image-preview-container">

                        <img src="@Model.ImageUrl"
                             alt="@Model.Name"
                             class="category-preview-image" />

                    </div>

                </div>
            }


            <!-- =================================================
                 ICON
            ================================================== -->

            <div class="category-form-group">

                <label asp-for="Icon">

                    Bootstrap Icon

                </label>


                <div class="category-input-wrapper">

                    <i class="bi bi-stars"></i>

                    <input asp-for="Icon"
                           class="category-form-control"
                           placeholder="e.g. bi bi-house-door" />

                </div>


                <small class="category-help">

                    Enter the Bootstrap Icons class for this service.

                    Example:

                    <strong>
                        bi bi-house-door
                    </strong>

                </small>


                <span asp-validation-for="Icon"
                      class="category-field-error">
                </span>

            </div>


            <!-- =================================================
                 DISPLAY ORDER
            ================================================== -->

            <div class="category-form-group">

                <label asp-for="DisplayOrder">

                    Display Order

                </label>


                <div class="category-input-wrapper">

                    <i class="bi bi-list-ol"></i>

                    <input asp-for="DisplayOrder"
                           type="number"
                           min="0"
                           class="category-form-control"
                           placeholder="0" />

                </div>


                <small class="category-help">

                    Lower numbers will appear first on the public website.

                </small>


                <span asp-validation-for="DisplayOrder"
                      class="category-field-error">
                </span>

            </div>


            <!-- =================================================
                 ACTIVE STATUS
            ================================================== -->

            <div class="category-status-box">

                <div class="category-status-info">

                    <div class="category-status-icon">

                        <i class="bi bi-toggle-on"></i>

                    </div>


                    <div>

                        <strong>
                            Service Status
                        </strong>

                        <span>
                            Enable or disable this service.
                        </span>

                    </div>

                </div>


                <div class="category-switch">

                    <input asp-for="IsActive"
                           class="category-switch-input"
                           type="checkbox"
                           id="IsActive" />


                    <label for="IsActive"
                           class="category-switch-label">

                        <span></span>

                    </label>

                </div>

            </div>


            <!-- =================================================
                 BUTTONS
            ================================================== -->

            <div class="category-form-actions">

                <a asp-controller="Category"
                   asp-action="Index"
                   class="category-cancel-button">

                    <i class="bi bi-x-lg"></i>

                    Cancel

                </a>


                <button type="submit"
                        class="category-save-button">

                    <i class="bi bi-check-lg"></i>

                    Save Changes

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}