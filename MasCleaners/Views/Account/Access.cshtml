@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Admin Login - MAS Cleaners</title>

    <link rel="icon"
          type="image/png"
          href="~/images/mas-logo.jpg" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Admin Login CSS -->
    <link rel="stylesheet"
          href="~/css/account/admin-login.css"
          asp-append-version="true" />

</head>

<body>

    <div class="mas-login-page">

        <!-- =====================================================
             LEFT SIDE
        ====================================================== -->

        <section class="mas-login-visual">

            <img src="~/images/hero-1.jpg"
                 alt="MAS Cleaners"
                 class="mas-login-background" />

            <div class="mas-login-overlay"></div>


            <div class="mas-login-visual-content">

                <div class="mas-login-brand">

                    <h1>
                        From Mess
                        <span>to Fresh.</span>
                    </h1>

                    <p>
                        Admin portal for managing bookings,
                        earnings, and advertising.
                    </p>

                </div>


                <div class="mas-login-security">

                    <i class="bi bi-shield-check"></i>

                    <span>
                        Secure owner access only
                    </span>

                </div>

            </div>

        </section>


        <!-- =====================================================
             RIGHT SIDE
        ====================================================== -->

        <section class="mas-login-form-section">

            <div class="mas-login-form-wrapper">


                <!-- Heading -->

                <div class="mas-login-heading">

                    <h2>
                        Admin Login
                    </h2>

                    <p>
                        Sign in with your owner credentials
                        to manage bookings.
                    </p>

                </div>


                <!-- Login Form -->

                <form asp-controller="Admin"
                      asp-action="Login"
                      method="post"
                      class="mas-login-form">

                    @Html.AntiForgeryToken()


                    <!-- Email -->

                    <div class="mas-form-group">

                        <label for="email">
                            Email Address
                        </label>

                        <div class="mas-input-wrapper">

                            <input type="email"
                                   id="email"
                                   name="email"
                                   class="mas-login-input"
                                   placeholder="mascleaners@gmail.com"
                                   autocomplete="email"
                                   required />

                        </div>

                    </div>


                    <!-- Password -->

                    <div class="mas-form-group">

                        <label for="password">
                            Password
                        </label>

                        <div class="mas-input-wrapper">

                            <input type="password"
                                   id="password"
                                   name="password"
                                   class="mas-login-input"
                                   placeholder="••••••••"
                                   autocomplete="current-password"
                                   required />

                            <button type="button"
                                    class="mas-password-toggle"
                                    id="passwordToggle"
                                    aria-label="Show password">

                                <i class="bi bi-eye"
                                   id="passwordIcon"></i>

                            </button>

                        </div>

                    </div>


                    <!-- Error -->
                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="mas-login-error">

                            <i class="bi bi-exclamation-circle"></i>

                            <span>
                                Invalid email address or password.
                            </span>

                        </div>
                    }


                    <!-- Sign In -->

                    <button type="submit"
                            class="mas-login-button">

                        <i class="bi bi-lock"></i>

                        <span>
                            Sign In
                        </span>

                    </button>


                </form>


                <!-- Back -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="mas-back-link">

                    <i class="bi bi-chevron-left"></i>

                    <span>
                        Back to website
                    </span>

                </a>


            </div>

        </section>

    </div>


    <script>

            document.addEventListener("DOMContentLoaded", function() {

                const passwordInput =
                    document.getElementById("password");

                const passwordToggle =
                    document.getElementById("passwordToggle");

                const passwordIcon =
                    document.getElementById("passwordIcon");


                if (passwordToggle) {

                    passwordToggle.addEventListener("click", function() {

                        const isPassword =
                            passwordInput.type === "password";


                        passwordInput.type =
                            isPassword ? "text" : "password";


                        passwordIcon.className =
                            isPassword
                                ? "bi bi-eye-slash"
                                : "bi bi-eye";


                        passwordToggle.setAttribute(
                            "aria-label",
                            isPassword
                                ? "Hide password"
                                : "Show password"
                        );

                    });

                }

            });

    </script>

</body>

</html>