@model MasCleaners.ViewModels.Customer.CustomerChangePasswordVM
<link rel="stylesheet"
      href="~/css/customer/customer-account-settings.css"
      asp-append-version="true" />
@{
    ViewData["Title"] = "Change Password";
}

<div class="mas-account-settings-page">

    <div class="mas-settings-header">
        <div>
            <a asp-action="SecuritySettings"
               asp-controller="Account"
               class="mas-settings-back">
                <i class="bi bi-arrow-left"></i> Security Settings
            </a>

            <h1>Change Password</h1>
            <p>Update your password to keep your account secure.</p>
        </div>

        <div class="mas-settings-header-icon">
            <i class="bi bi-key"></i>
        </div>
    </div>

    <div class="mas-settings-card">

        <div class="mas-settings-card-heading">
            <span><i class="bi bi-shield-lock"></i></span>
            <div>
                <h2>Update Your Password</h2>
                <p>Enter your current password and choose a new one.</p>
            </div>
        </div>

        <form asp-action="ChangePassword"
              asp-controller="Account"
              method="post"
              class="mas-settings-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mas-settings-field">
                <label asp-for="CurrentPassword"></label>
                <input asp-for="CurrentPassword"
                       class="form-control"
                       autocomplete="current-password"
                       placeholder="Enter current password" />
                <span asp-validation-for="CurrentPassword"
                      class="text-danger"></span>
            </div>

            <div class="mas-settings-field">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Enter new password" />
                <span asp-validation-for="NewPassword"
                      class="text-danger"></span>
                <small>Use at least 8 characters. Your application's Identity rules also apply.</small>
            </div>

            <div class="mas-settings-field">
                <label asp-for="ConfirmNewPassword"></label>
                <input asp-for="ConfirmNewPassword"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Confirm new password" />
                <span asp-validation-for="ConfirmNewPassword"
                      class="text-danger"></span>
            </div>

            <div class="mas-password-notice">
                <i class="bi bi-info-circle"></i>
                <p>
                    Your current password is required to authorise this change.
                    Never share your password with anyone.
                </p>
            </div>

            <div class="mas-settings-actions">
                <a asp-action="SecuritySettings"
                   asp-controller="Account"
                   class="mas-settings-cancel">
                    Cancel
                </a>

                <button type="submit" class="mas-settings-save">
                    <i class="bi bi-shield-check"></i>
                    Update Password
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}